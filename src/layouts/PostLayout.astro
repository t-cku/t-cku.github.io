---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseLayout from './BaseLayout.astro';

export interface Props {
  title: string;
  date: Date;
  summary: string;
  tags?: string[];
  heroImage?: ImageMetadata;
  heroImageAlt?: string;
  backHref: string;
  backLabel: string;
}

const {
  title,
  date,
  summary,
  tags = [],
  heroImage,
  heroImageAlt = '',
  backHref,
  backLabel,
} = Astro.props;

const formattedDate = date.toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
});
---

<BaseLayout title={title} description={summary}>
  <article>
    <p><a href={backHref}>&larr; {backLabel}</a></p>
    <header class="post-header">
      <h1>{title}</h1>
      <p class="card-date">{formattedDate}</p>
      {
        tags.length > 0 && (
          <ul class="tag-list">
            {tags.map((tag) => (
              <li class="tag">{tag}</li>
            ))}
          </ul>
        )
      }
    </header>
    {heroImage && <Image src={heroImage} alt={heroImageAlt} width={960} height={540} />}
    <div class="post-body">
      <slot />
    </div>
  </article>
</BaseLayout>

<style>
  .post-header {
    margin-bottom: var(--space-3);
  }

  .post-body {
    margin-top: var(--space-3);
    max-width: 42rem;
  }

  .post-body :global(img) {
    margin-block: var(--space-2);
  }
</style>
