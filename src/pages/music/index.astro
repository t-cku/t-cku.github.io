---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FeaturedGrid from '../../components/FeaturedGrid.astro';
import { getPublished } from '../../lib/content';

const posts = await getPublished('music');
const items = posts.map((entry) => ({ entry, href: `/music/${entry.id}` }));
---

<BaseLayout title="Music" description="Posts on classical music, opera and art.">
  <h1>Music</h1>
  <FeaturedGrid items={items} />
</BaseLayout>
