---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BoxGrid from '../../components/BoxGrid.astro';
import { getPublished } from '../../lib/content';
import { skillCategories } from '../../config/skills';
import viterbiLogo from '../../assets/usc-viterbi.png';

const entries = await getPublished('engineering');
---

<BaseLayout
  title="Engineering"
  description="Software and hardware projects, links, and write-ups of ideas from classes."
>
  <div class="page-heading">
    <h1>Engineering</h1>
    <Image src={viterbiLogo} alt="USC Viterbi School of Engineering" width={300} class="school-logo" />
  </div>

  <div class="skills">
    {
      skillCategories.map((category) => (
        <div class="skill-category">
          <h3>{category.label}</h3>
          <ul class="tag-list">
            {category.skills.map((skill) => (
              <li class="tag">{skill}</li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>

  <section class="section-block">
    <BoxGrid entries={entries} basePath="/engineering" />
  </section>
</BaseLayout>

<style>
  .page-heading {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-1) var(--space-3);
  }

  .school-logo {
    width: 150px;
    height: auto;
    border-radius: 0;
  }

  .skills {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-top: var(--space-3);
    margin-bottom: var(--space-5);
  }

  .skill-category h3 {
    font-size: 0.95rem;
    margin: 0 0 var(--space-1);
  }
</style>
