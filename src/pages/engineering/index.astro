---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublished } from '../../lib/content';
import { skillCategories } from '../../config/skills';

const entries = await getPublished('engineering');

const boxes = entries.map((entry) => {
  const ctaHref = entry.data.link?.url ?? `/engineering/${entry.id}`;
  const ctaLabel = entry.data.link?.label ?? 'View more';
  const isExternal = /^https?:\/\//.test(ctaHref);

  return {
    entry,
    ctaHref,
    ctaLabel,
    isExternal,
    formattedDate: entry.data.date.toLocaleDateString('en-GB', {
      month: 'long',
      year: 'numeric',
      timeZone: 'UTC',
    }),
  };
});
---

<BaseLayout
  title="Engineering"
  description="Software and hardware projects, links, and write-ups of ideas from classes."
>
  <h1>Engineering</h1>

  <div class="skills">
    {
      skillCategories.map((category) => (
        <div class="skill-category">
          <h3>{category.label}</h3>
          <ul class="tag-list">
            {category.skills.map((skill) => (
              <li class="tag">{skill}</li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>

  <section class="section-block">
    {
      boxes.length > 0 ? (
        <div class="box-grid">
          {boxes.map(({ entry, ctaHref, ctaLabel, isExternal, formattedDate }) => (
            <div class="card box">
              {entry.data.heroImage && (
                <Image src={entry.data.heroImage} alt={entry.data.heroImageAlt ?? ''} width={480} height={270} />
              )}
              <p class="card-date">{formattedDate}</p>
              <h3>{entry.data.title}</h3>
              <p class="card-summary">{entry.data.summary}</p>
              {entry.data.tags.length > 0 && (
                <ul class="tag-list">
                  {entry.data.tags.map((tag) => (
                    <li class="tag">{tag}</li>
                  ))}
                </ul>
              )}
              <a
                class="box-cta"
                href={ctaHref}
                target={isExternal ? '_blank' : undefined}
                rel={isExternal ? 'noopener noreferrer' : undefined}
              >
                {ctaLabel} {isExternal ? '↗' : '→'}
              </a>
            </div>
          ))}
        </div>
      ) : (
        <p class="empty-state">Nothing here yet — check back soon.</p>
      )
    }
  </section>
</BaseLayout>

<style>
  .skills {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-top: var(--space-3);
  }

  .skill-category h3 {
    font-size: 0.95rem;
    margin: 0 0 var(--space-1);
  }

  .box-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-3);
  }

  @media (min-width: 768px) {
    .box-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .box-cta {
    margin-top: auto;
    padding-top: var(--space-1);
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
  }

  .box-cta:hover {
    text-decoration: underline;
  }
</style>
