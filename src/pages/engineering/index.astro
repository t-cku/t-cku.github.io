---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BoxGrid from '../../components/BoxGrid.astro';
import { getPublished } from '../../lib/content';
import { skillCategories } from '../../config/skills';
import viterbiLogo from '../../assets/usc-viterbi.png';

const entries = await getPublished('engineering');
---

<BaseLayout
  title="Engineering"
  description="Software and hardware projects, links, and write-ups of ideas from classes."
>
  <div class="page-heading">
    <h1>Engineering</h1>
    <Image src={viterbiLogo} alt="USC Viterbi School of Engineering" width={300} class="school-logo" />
  </div>

  <dl class="skills">
    {
      skillCategories.map((category) => (
        <div class="skill-row">
          <dt>{category.label}</dt>
          <dd>
            <ul>
              {category.skills.map((skill) => (
                <li>{skill}</li>
              ))}
            </ul>
          </dd>
        </div>
      ))
    }
  </dl>

  <section class="section-block">
    <BoxGrid entries={entries} basePath="/engineering" />
  </section>
</BaseLayout>

<style>
  .page-heading {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-1) var(--space-3);
  }

  .school-logo {
    width: 150px;
    height: auto;
    border-radius: 0;
  }

  .skills {
    margin: var(--space-3) 0 var(--space-5);
    border-top: 1px solid var(--colour-border);
  }

  .skill-row {
    display: grid;
    grid-template-columns: 7rem 1fr;
    gap: var(--space-2);
    padding: 0.85rem 0;
    border-bottom: 1px solid var(--colour-border);
  }

  .skill-row dt {
    font-family: var(--font-heading);
    font-size: 0.95rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding-top: 0.15rem;
  }

  .skill-row dd {
    margin: 0;
  }

  .skill-row ul {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    margin: 0;
    padding: 0;
    line-height: 1.7;
  }

  .skill-row li:not(:last-child)::after {
    content: '·';
    margin: 0 0.5rem;
    color: var(--colour-text-muted);
  }

  @media (max-width: 30rem) {
    .skill-row {
      grid-template-columns: 1fr;
      gap: 0.25rem;
    }
  }
</style>
