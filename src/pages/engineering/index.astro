---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BoxGrid from '../../components/BoxGrid.astro';
import { getPublished } from '../../lib/content';
import { skillCategories } from '../../config/skills';

const entries = await getPublished('engineering');
---

<BaseLayout
  title="Engineering"
  description="Software and hardware projects, links, and write-ups of ideas from classes."
>
  <h1>Engineering</h1>

  <div class="skills">
    {
      skillCategories.map((category) => (
        <div class="skill-category">
          <h3>{category.label}</h3>
          <ul class="tag-list">
            {category.skills.map((skill) => (
              <li class="tag">{skill}</li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>

  <section class="section-block">
    <BoxGrid entries={entries} basePath="/engineering" />
  </section>
</BaseLayout>

<style>
  .skills {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-top: var(--space-3);
    margin-bottom: var(--space-5);
  }

  .skill-category h3 {
    font-size: 0.95rem;
    margin: 0 0 var(--space-1);
  }
</style>
