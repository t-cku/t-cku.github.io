---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../config/site';
import restaurantPhoto from '../assets/profile-restaurant.jpg';
import parisPhoto from '../assets/profile-paris.jpg';
---

<BaseLayout title={siteConfig.name}>
  <section class="hero">
    <div class="hero-photo">
      <button type="button" class="hero-photo-frame" aria-pressed="false" aria-label="View another photo">
        <span class="hero-photo-card">
          <span class="hero-photo-face hero-photo-front">
            <Image
              src={restaurantPhoto}
              alt="Tiffany Ku smiling, seated at a wooden table in a restaurant"
              width={480}
              height={600}
              fit="cover"
              position="top"
            />
          </span>
          <span class="hero-photo-face hero-photo-back">
            <Image
              src={parisPhoto}
              alt="Tiffany Ku smiling by the Seine at sunset, with the Eiffel Tower lit up in the background"
              width={480}
              height={600}
              fit="cover"
            />
          </span>
        </span>
      </button>
      <button type="button" class="hero-tag hero-switch" aria-pressed="false">
        <svg
          aria-hidden="true"
          viewBox="0 0 24 24"
          width="14"
          height="14"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M20 11a8 8 0 0 0-14.3-4.9L4 8M4 3v5h5M4 13a8 8 0 0 0 14.3 4.9L20 16M20 21v-5h-5" />
        </svg>
        <span>
          <span class="hero-tag-label">View</span>
          <span class="hero-tag-content">View</span>
        </span>
      </button>
      <button type="button" class="hero-tag" aria-pressed="false">
        <svg aria-hidden="true" viewBox="0 0 24 24" width="14" height="14">
          <path
            fill="currentColor"
            d="M12 2c-4.2 0-7.5 3.3-7.5 7.5 0 5.6 6.6 11.6 6.9 11.9a.8.8 0 0 0 1.2 0c.3-.3 6.9-6.3 6.9-11.9C19.5 5.3 16.2 2 12 2Zm0 10.5a3 3 0 1 1 0-6 3 3 0 0 1 0 6Z"
          />
        </svg>
        <span>
          <span class="hero-tag-label">Where I am</span>
          <span class="hero-tag-content">Hong Kong · London · Los Angeles</span>
        </span>
      </button>
      <button type="button" class="hero-tag" aria-pressed="false">
        <svg
          aria-hidden="true"
          viewBox="0 0 24 24"
          width="15"
          height="15"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <circle cx="14.5" cy="9.5" r="7.5" />
          <ellipse cx="14.5" cy="9.5" rx="3.2" ry="7.5" />
          <path d="M7 9.5h15M8.6 5.2q5.9 2.6 11.8 0M8.6 13.8q5.9-2.6 11.8 0" />
          <path
            d="M4 13h7a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2H7l-3 2.5V20a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2z"
            fill="var(--colour-bg)"
          />
          <path d="M5 15.8h5M5 17.8h5" />
        </svg>
        <span>
          <span class="hero-tag-label">Languages I speak</span>
          <span class="hero-tag-content">
            {siteConfig.languages.map((l) => ('label' in l ? l.label : l.name)).join(' · ')}
          </span>
        </span>
      </button>
    </div>
    <div class="hero-intro">
      <h1><span class="hero-greeting">Hello, I'm</span> {siteConfig.name}</h1>
      <p class="hero-typed">
        <span class="visually-hidden">{siteConfig.intro}</span>
        <span aria-hidden="true" data-typed-text={siteConfig.intro}
          ><span class="typed-done"></span><span class="typed-caret"></span><span class="typed-rest"
            >{siteConfig.intro}</span
          ></span
        >
      </p>
    </div>
  </section>
</BaseLayout>

<script>
  document.querySelectorAll<HTMLButtonElement>('.hero-tag:not(.hero-switch)').forEach((tag) => {
    tag.addEventListener('click', () => {
      tag.setAttribute('aria-pressed', String(tag.getAttribute('aria-pressed') !== 'true'));
    });
  });

  // The photo and its "View" caption share one state, so clicking either keeps both in step.
  const switchButtons = document.querySelectorAll<HTMLButtonElement>('.hero-photo-frame, .hero-switch');
  switchButtons.forEach((button) => {
    button.addEventListener('click', () => {
      const pressed = String(button.getAttribute('aria-pressed') !== 'true');
      switchButtons.forEach((b) => b.setAttribute('aria-pressed', pressed));
    });
  });

  // Types out the intro over a fixed duration once it scrolls into view. The untyped remainder stays in
  // the layout (invisible) so the page doesn't jump as text appears.
  const DURATION_MS = 5000;
  const START_DELAY_MS = 400;

  const root = document.querySelector<HTMLElement>('[data-typed-text]');
  const done = root?.querySelector<HTMLElement>('.typed-done');
  const rest = root?.querySelector<HTMLElement>('.typed-rest');
  const caret = root?.querySelector<HTMLElement>('.typed-caret');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (root && done && rest && caret && !reduceMotion) {
    const text = root.dataset.typedText ?? '';
    done.textContent = '';
    rest.textContent = text;
    caret.classList.add('is-typing');
    root.classList.add('is-typing-active');

    let start: number | null = null;
    const step = (now: number) => {
      start ??= now;
      const progress = Math.min((now - start) / DURATION_MS, 1);
      const count = Math.round(progress * text.length);
      done.textContent = text.slice(0, count);
      rest.textContent = text.slice(count);
      if (progress < 1) {
        requestAnimationFrame(step);
      } else {
        caret.classList.remove('is-typing');
        caret.classList.add('is-finished');
      }
    };
    // Wait until the paragraph is on screen (it sits below the photo on phones).
    const observer = new IntersectionObserver((entries) => {
      if (entries.some((entry) => entry.isIntersecting)) {
        observer.disconnect();
        setTimeout(() => requestAnimationFrame(step), START_DELAY_MS);
      }
    }, { threshold: 0.35 });
    observer.observe(root);
  } else if (rest && done) {
    done.textContent = rest.textContent;
    rest.textContent = '';
  }
</script>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-3);
  }

  .hero-intro p {
    color: var(--colour-text-muted);
    max-width: 38rem;
  }

  .is-typing-active .typed-rest {
    visibility: hidden;
  }

  .typed-caret {
    display: none;
  }

  .typed-caret.is-typing,
  .typed-caret.is-finished {
    display: inline-block;
    width: 2px;
    height: 1.1em;
    margin: 0 -1px -0.2em;
    background: var(--colour-accent);
  }

  .typed-caret.is-finished {
    animation: caret-blink 1s step-end 3 forwards;
  }

  @keyframes caret-blink {
    50% {
      opacity: 0;
    }
    100% {
      opacity: 0;
    }
  }

  .hero-intro h1 {
    text-align: center;
    font-size: clamp(2.5rem, 7vw, 3.5rem);
    line-height: 1.1;
  }

  .hero-greeting {
    display: block;
    font-family: var(--font-body);
    font-weight: 400;
    font-size: 1rem;
    line-height: 1.6;
    color: var(--colour-text-muted);
    margin-bottom: var(--space-2);
  }

  .hero-photo {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-1);
  }

  /* Fixed width: the button's stacked photos give it no intrinsic size, so 100% would shrink it to the tags. */
  .hero-photo-frame {
    width: 220px;
    max-width: 100%;
    aspect-ratio: 4 / 5;
    padding: 0;
    background: none;
    border: none;
    border-radius: 0.75rem;
    cursor: pointer;
  }

  .hero-photo-frame:focus {
    outline: none;
  }

  .hero-photo-frame:focus-visible {
    outline: 1px solid var(--colour-accent);
    outline-offset: 3px;
  }

  /* Both photos are stacked; pressing the frame fades the Paris one in over the restaurant one. */
  .hero-photo-card {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
  }

  .hero-photo-face {
    position: absolute;
    inset: 0;
    border-radius: 0.75rem;
    overflow: hidden;
  }

  .hero-photo-back {
    opacity: 0;
    transition: opacity 0.5s ease;
  }

  .hero-photo-frame[aria-pressed='true'] .hero-photo-back {
    opacity: 1;
  }

  .hero-photo-face :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* The Paris shot is landscape, so zoom in on the middle to keep the face readable. */
  .hero-photo-back :global(img) {
    transform: scale(1.15);
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-photo-back {
      transition: none;
    }
  }

  .hero-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    max-width: 100%;
    padding: 0.15rem 0;
    background: none;
    border: none;
    color: var(--colour-text-muted);
    font: inherit;
    font-size: 0.8rem;
    cursor: pointer;
    transition: color 0.2s ease;
  }

  .hero-tag:hover,
  .hero-tag[aria-pressed='true'] {
    color: var(--colour-text);
  }

  .hero-tag:focus {
    outline: none;
  }

  .hero-tag:focus-visible {
    outline: 1px solid var(--colour-accent);
    outline-offset: 3px;
    border-radius: 2px;
  }

  .hero-tag svg {
    flex-shrink: 0;
    opacity: 0.7;
  }

  .hero-tag-label {
    text-decoration: underline dotted;
    text-decoration-color: var(--colour-border);
    text-underline-offset: 0.25em;
  }

  .hero-tag:hover .hero-tag-label {
    text-decoration-color: currentColor;
  }

  .hero-tag-content,
  .hero-tag[aria-pressed='true'] .hero-tag-label {
    display: none;
  }

  .hero-tag[aria-pressed='true'] .hero-tag-content {
    display: inline;
  }

  .hero-tag-label,
  .hero-tag-content {
    animation: hero-tag-swap 0.25s ease;
  }

  @keyframes hero-tag-swap {
    from {
      opacity: 0;
      transform: translateY(0.25rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-tag-label,
    .hero-tag-content {
      animation: none;
    }
  }

  @media (min-width: 640px) {
    .hero {
      grid-template-columns: 1fr auto;
      align-items: center;
    }

    .hero-intro {
      grid-column: 1;
      grid-row: 1;
    }

    .hero-intro h1 {
      text-align: left;
    }

    .hero-photo {
      grid-column: 2;
      grid-row: 1;
    }
  }
</style>
