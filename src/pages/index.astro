---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../config/site';
import profilePhoto from '../assets/profile.jpg';
---

<BaseLayout title={siteConfig.name}>
  <section class="hero">
    <div class="hero-photo">
      <div class="hero-photo-frame">
        <Image
          src={profilePhoto}
          alt="Tiffany Ku smiling by the Seine at sunset, with the Eiffel Tower lit up in the background"
          width={480}
          height={600}
          fit="cover"
        />
      </div>
      <p class="hero-tag">
        <svg aria-hidden="true" viewBox="0 0 24 24" width="14" height="14">
          <path
            fill="currentColor"
            d="M12 2c-4.2 0-7.5 3.3-7.5 7.5 0 5.6 6.6 11.6 6.9 11.9a.8.8 0 0 0 1.2 0c.3-.3 6.9-6.3 6.9-11.9C19.5 5.3 16.2 2 12 2Zm0 10.5a3 3 0 1 1 0-6 3 3 0 0 1 0 6Z"
          />
        </svg>
        Hong Kong · London · Los Angeles
      </p>
      <p
        class="hero-tag"
        title={siteConfig.languages.map((l) => (l.note ? `${l.name} (${l.note})` : l.name)).join(' · ')}
      >
        <svg
          aria-hidden="true"
          viewBox="0 0 24 24"
          width="15"
          height="15"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <circle cx="14.5" cy="9.5" r="7.5" />
          <ellipse cx="14.5" cy="9.5" rx="3.2" ry="7.5" />
          <path d="M7 9.5h15M8.6 5.2q5.9 2.6 11.8 0M8.6 13.8q5.9-2.6 11.8 0" />
          <path
            d="M4 13h7a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2H7l-3 2.5V20a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2z"
            fill="var(--colour-bg-subtle)"
          />
          <path d="M5 15.8h5M5 17.8h5" />
        </svg>
        {siteConfig.languages.map((l) => ('label' in l ? l.label : l.name)).join(' · ')}
      </p>
    </div>
    <div class="hero-intro">
      <h1><span class="hero-greeting">Hello, I'm</span> {siteConfig.name}</h1>
      <p>{siteConfig.intro}</p>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-3);
  }

  .hero-intro p {
    color: var(--colour-text-muted);
    max-width: 38rem;
  }

  .hero-intro h1 {
    text-align: center;
    font-size: clamp(2.5rem, 7vw, 3.5rem);
    line-height: 1.1;
  }

  .hero-greeting {
    display: block;
    font-family: var(--font-body);
    font-weight: 400;
    font-size: 1rem;
    line-height: 1.6;
    color: var(--colour-text-muted);
    margin-bottom: var(--space-2);
  }

  .hero-photo {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-1);
  }

  .hero-photo-frame {
    width: 100%;
    max-width: 220px;
    aspect-ratio: 4 / 5;
    border-radius: 0.75rem;
    overflow: hidden;
  }

  .hero-photo-frame :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.15);
  }

  .hero-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin: 0;
    padding: 0.25rem 0.85rem;
    border-radius: 999px;
    background: var(--colour-bg-subtle);
    border: 1px solid var(--colour-border);
    color: var(--colour-text-muted);
    font-size: 0.8rem;
  }

  @media (min-width: 640px) {
    .hero {
      grid-template-columns: 1fr auto;
      align-items: center;
    }

    .hero-intro {
      grid-column: 1;
      grid-row: 1;
    }

    .hero-intro h1 {
      text-align: left;
    }

    .hero-photo {
      grid-column: 2;
      grid-row: 1;
    }
  }
</style>
