---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../config/site';
import profilePhoto from '../assets/profile.jpg';
---

<BaseLayout title={siteConfig.name}>
  <section class="hero">
    <div class="hero-photo">
      <div class="hero-photo-frame">
        <Image
          src={profilePhoto}
          alt="Tiffany Ku smiling by the Seine at sunset, with the Eiffel Tower lit up in the background"
          width={480}
          height={600}
          fit="cover"
        />
      </div>
      <details class="hero-tag">
        <summary>
          <svg aria-hidden="true" viewBox="0 0 24 24" width="14" height="14">
            <path
              fill="currentColor"
              d="M12 2c-4.2 0-7.5 3.3-7.5 7.5 0 5.6 6.6 11.6 6.9 11.9a.8.8 0 0 0 1.2 0c.3-.3 6.9-6.3 6.9-11.9C19.5 5.3 16.2 2 12 2Zm0 10.5a3 3 0 1 1 0-6 3 3 0 0 1 0 6Z"
            />
          </svg>
          Where I am
          <span class="hero-tag-chevron" aria-hidden="true"></span>
        </summary>
        <p class="hero-tag-content">Hong Kong · London · Los Angeles</p>
      </details>
      <details class="hero-tag">
        <summary>
          <svg
            aria-hidden="true"
            viewBox="0 0 24 24"
            width="15"
            height="15"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <circle cx="14.5" cy="9.5" r="7.5" />
            <ellipse cx="14.5" cy="9.5" rx="3.2" ry="7.5" />
            <path d="M7 9.5h15M8.6 5.2q5.9 2.6 11.8 0M8.6 13.8q5.9-2.6 11.8 0" />
            <path
              d="M4 13h7a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2H7l-3 2.5V20a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2z"
              fill="var(--colour-bg-subtle)"
            />
            <path d="M5 15.8h5M5 17.8h5" />
          </svg>
          Languages I speak
          <span class="hero-tag-chevron" aria-hidden="true"></span>
        </summary>
        <p class="hero-tag-content">
          {siteConfig.languages.map((l) => ('label' in l ? l.label : l.name)).join(' · ')}
        </p>
      </details>
    </div>
    <div class="hero-intro">
      <h1><span class="hero-greeting">Hello, I'm</span> {siteConfig.name}</h1>
      <p class="hero-typed">
        <span class="visually-hidden">{siteConfig.intro}</span>
        <span aria-hidden="true" data-typed-text={siteConfig.intro}
          ><span class="typed-done"></span><span class="typed-caret"></span><span class="typed-rest"
            >{siteConfig.intro}</span
          ></span
        >
      </p>
    </div>
  </section>
</BaseLayout>

<script>
  // Types out the intro over a fixed duration once it scrolls into view. The untyped remainder stays in
  // the layout (invisible) so the page doesn't jump as text appears.
  const DURATION_MS = 5000;
  const START_DELAY_MS = 400;

  const root = document.querySelector<HTMLElement>('[data-typed-text]');
  const done = root?.querySelector<HTMLElement>('.typed-done');
  const rest = root?.querySelector<HTMLElement>('.typed-rest');
  const caret = root?.querySelector<HTMLElement>('.typed-caret');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (root && done && rest && caret && !reduceMotion) {
    const text = root.dataset.typedText ?? '';
    done.textContent = '';
    rest.textContent = text;
    caret.classList.add('is-typing');
    root.classList.add('is-typing-active');

    let start: number | null = null;
    const step = (now: number) => {
      start ??= now;
      const progress = Math.min((now - start) / DURATION_MS, 1);
      const count = Math.round(progress * text.length);
      done.textContent = text.slice(0, count);
      rest.textContent = text.slice(count);
      if (progress < 1) {
        requestAnimationFrame(step);
      } else {
        caret.classList.remove('is-typing');
        caret.classList.add('is-finished');
      }
    };
    // Wait until the paragraph is on screen (it sits below the photo on phones).
    const observer = new IntersectionObserver((entries) => {
      if (entries.some((entry) => entry.isIntersecting)) {
        observer.disconnect();
        setTimeout(() => requestAnimationFrame(step), START_DELAY_MS);
      }
    }, { threshold: 0.35 });
    observer.observe(root);
  } else if (rest && done) {
    done.textContent = rest.textContent;
    rest.textContent = '';
  }
</script>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-3);
  }

  .hero-intro p {
    color: var(--colour-text-muted);
    max-width: 38rem;
  }

  .is-typing-active .typed-rest {
    visibility: hidden;
  }

  .typed-caret {
    display: none;
  }

  .typed-caret.is-typing,
  .typed-caret.is-finished {
    display: inline-block;
    width: 2px;
    height: 1.1em;
    margin: 0 -1px -0.2em;
    background: var(--colour-accent);
  }

  .typed-caret.is-finished {
    animation: caret-blink 1s step-end 3 forwards;
  }

  @keyframes caret-blink {
    50% {
      opacity: 0;
    }
    100% {
      opacity: 0;
    }
  }

  .hero-intro h1 {
    text-align: center;
    font-size: clamp(2.5rem, 7vw, 3.5rem);
    line-height: 1.1;
  }

  .hero-greeting {
    display: block;
    font-family: var(--font-body);
    font-weight: 400;
    font-size: 1rem;
    line-height: 1.6;
    color: var(--colour-text-muted);
    margin-bottom: var(--space-2);
  }

  .hero-photo {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-1);
  }

  .hero-photo-frame {
    width: 100%;
    max-width: 220px;
    aspect-ratio: 4 / 5;
    border-radius: 0.75rem;
    overflow: hidden;
  }

  .hero-photo-frame :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.15);
  }

  .hero-tag {
    display: flex;
    flex-direction: column;
    align-items: center;
    color: var(--colour-text-muted);
    font-size: 0.8rem;
  }

  .hero-tag summary {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.25rem 0.85rem;
    border-radius: 999px;
    background: var(--colour-bg-subtle);
    border: 1px solid var(--colour-border);
    cursor: pointer;
    list-style: none;
    user-select: none;
  }

  .hero-tag summary::-webkit-details-marker {
    display: none;
  }

  .hero-tag summary:hover {
    color: var(--colour-text);
  }

  .hero-tag-chevron {
    width: 0.4rem;
    height: 0.4rem;
    margin-left: 0.15rem;
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    transform: translateY(-0.1rem) rotate(45deg);
    transition: transform 0.2s ease;
  }

  .hero-tag[open] .hero-tag-chevron {
    transform: translateY(0.1rem) rotate(-135deg);
  }

  .hero-tag-content {
    margin: 0.4rem 0 0;
    text-align: center;
    color: var(--colour-text);
    animation: hero-tag-reveal 0.25s ease;
  }

  @keyframes hero-tag-reveal {
    from {
      opacity: 0;
      transform: translateY(-0.25rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-tag-content,
    .hero-tag-chevron {
      animation: none;
      transition: none;
    }
  }

  @media (min-width: 640px) {
    .hero {
      grid-template-columns: 1fr auto;
      align-items: center;
    }

    .hero-intro {
      grid-column: 1;
      grid-row: 1;
    }

    .hero-intro h1 {
      text-align: left;
    }

    .hero-photo {
      grid-column: 2;
      grid-row: 1;
    }
  }
</style>
