---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FeaturedGrid from '../../components/FeaturedGrid.astro';
import TagFilter from '../../components/TagFilter.astro';
import { getPublished } from '../../lib/content';

const builds = await getPublished('product-builds');
const writing = await getPublished('product-writing');

const buildItems = builds.map((entry) => ({ entry, href: `/product/builds/${entry.id}` }));
const writingItems = writing.map((entry) => ({ entry, href: `/product/writing/${entry.id}` }));

const allTags = new Set<string>();
[...builds, ...writing].forEach((entry) => entry.data.tags.forEach((tag) => allTags.add(tag)));
const tags = [...allTags].sort((a, b) => a.localeCompare(b));
---

<BaseLayout title="Product" description="Vibe-coded tools, product reviews and blog posts.">
  <h1>Product</h1>

  <div class="intro">
    <p>
      I've always been curious about why some products just click and others don't. In March 2026, I
      joined an AI-powered wellness and music platform, as a product manager, working with founders and
      engineers in New York and London. My time there gave me my first real taste of taking a product
      from messy ideas to a working v1.
    </p>
    <p>
      This page collects what I'm exploring: small tools I've built with AI, reviews of products I use
      every day, and notes on ideas I'm thinking through.
    </p>
  </div>

  <TagFilter tags={tags} />

  <section class="section-block">
    <div class="section-heading">
      <h2>Builds</h2>
    </div>
    <FeaturedGrid items={buildItems} />
  </section>

  <section class="section-block">
    <div class="section-heading">
      <h2>Writing</h2>
    </div>
    <FeaturedGrid items={writingItems} />
  </section>
</BaseLayout>

<style>
  .intro {
    max-width: 42rem;
    margin-top: var(--space-2);
    margin-bottom: var(--space-3);
  }

  .intro p {
    color: var(--colour-text-muted);
  }
</style>
