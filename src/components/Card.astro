---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

export interface Props {
  href: string;
  title: string;
  date: Date;
  summary: string;
  tags?: string[];
  image?: ImageMetadata;
  imageAlt?: string;
}

const { href, title, date, summary, tags = [], image, imageAlt = '' } = Astro.props;

const formattedDate = date.toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
});
---

<a href={href} class="card card-link" data-tags={tags.join(',')}>
  {image && <Image src={image} alt={imageAlt} width={480} height={270} />}
  <p class="card-date">{formattedDate}</p>
  <h3>{title}</h3>
  <p class="card-summary">{summary}</p>
  {
    tags.length > 0 && (
      <ul class="tag-list">
        {tags.map((tag) => (
          <li class="tag">{tag}</li>
        ))}
      </ul>
    )
  }
</a>
