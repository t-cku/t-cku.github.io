  /* Picker itself uses fixed colours so it stays readable on every palette. */
  .dev-theme-picker {
    position: fixed;
    right: 1rem;
    bottom: 1rem;
    z-index: 1000;
    display: grid;
    gap: 0.5rem;
    width: min(18rem, calc(100vw - 2rem));
    padding: 0.85rem 1rem;
    background: #ffffff;
    color: #1a1a1a;
    border: 1px solid #d0d0d4;
    border-radius: 0.75rem;
    box-shadow: 0 8px 24px rgb(0 0 0 / 0.18);
    font: 0.85rem/1.4 system-ui, sans-serif;
  }

  .dev-theme-title {
    margin: 0;
    font-weight: 700;
  }

  .dev-theme-title span {
    font-weight: 400;
    color: #6b6b70;
  }

  .dev-theme-picker label {
    display: grid;
    gap: 0.2rem;
    font-weight: 600;
  }

  .dev-theme-picker select {
    font: inherit;
    font-weight: 400;
    padding: 0.3rem;
