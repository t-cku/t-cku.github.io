</style>

<script is:inline>
  const root = document.documentElement;
  document.querySelectorAll('.dev-theme-picker select').forEach((select) => {
    const attr = select.dataset.attr;
    const key = `dev-theme-${attr}`;
    let saved = '';
    try {
      saved = localStorage.getItem(key) ?? '';
    } catch {}
    select.value = saved;
    root.dataset[attr] = saved;

    select.addEventListener('change', () => {
      root.dataset[attr] = select.value;
      try {
        localStorage.setItem(key, select.value);
      } catch {}
    });
  });
</script>
